[Unit]
Description=ODI Agent - Node Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=oracle
Group=oinstall
LimitNOFILE=65536
TimeoutStartSec=180
TimeoutStopSec=120
ExecStart=/progiciel/oracle/scripts/agent_nm_start.sh
ExecStop=/progiciel/oracle/scripts/agent_nm_stop.sh

[Install]
WantedBy=multi-user.target
